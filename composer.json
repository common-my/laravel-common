{
    "name": "common-my/laravel-common",
    "description": "A Base Common Package",
    "keywords": [
        "laravel",
        "base",
        "common"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "lockmaey",
            "email": "lockmaey@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CommonMy\\LaravelCommon\\": "src/"
        },
        "files": [
            "src/Helpers/Abort.php",
            "src/Helpers/ArrayHelper.php",
            "src/Helpers/ImageHelper.php",
            "src/Helpers/NumberHelper.php",
            "src/Helpers/Response.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CommonMy\\LaravelCommon\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CommonMy\\LaravelCommon\\LaravelCommonServiceProvider"
            ],
            "aliases": {
                "LaravelCommon": "CommonMy\\LaravelCommon\\Facades\\LaravelCommon"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}